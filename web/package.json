{
  "name": "web",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "react-router build && node -e \"require('node:fs').rmSync('build/server', { recursive: true, force: true })\" && node scripts/precompress-assets.mjs build/client",
    "dev": "react-router dev --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview --host 127.0.0.1 --outDir build/client",
    "start": "vite preview --host 127.0.0.1 --outDir build/client",
    "test": "vitest",
    "test:run": "vitest --run && node --test scripts/*.test.mjs",
    "pretest:e2e": "playwright install chromium-headless-shell",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium-headless-shell",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@react-router/node": "8.3.0",
    "isbot": "^5.2.2",
    "js-yaml": "^5.4.1",
    "prism-react-renderer": "^2.4.1",
    "qrcode.react": "4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
